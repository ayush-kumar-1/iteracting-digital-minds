{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "properties": {
    "context": {
      "minLength": 1,
      "type": "string"
    },
    "option_a": {
      "minLength": 1,
      "type": "string"
    },
    "option_a_pole": {
      "minLength": 1,
      "type": "string"
    },
    "option_b": {
      "minLength": 1,
      "type": "string"
    },
    "option_b_pole": {
      "minLength": 1,
      "type": "string"
    },
    "option_orders": {
      "const": [
        "AB",
        "BA"
      ],
      "type": "array"
    },
    "revision": {
      "minimum": 1,
      "type": "integer"
    },
    "scenario_id": {
      "minLength": 1,
      "type": "string"
    },
    "scenario_type": {
      "type": "string"
    }
  },
  "required": [
    "scenario_id",
    "scenario_type",
    "context",
    "option_a",
    "option_b",
    "option_a_pole",
    "option_b_pole",
    "option_orders",
    "revision"
  ],
  "type": "object"
}
