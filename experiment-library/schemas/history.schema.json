{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "properties": {
    "frame_id": {
      "pattern": "^F[0-9]{2}$",
      "type": "string"
    },
    "history_id": {
      "pattern": "^F[0-9]{2}_H[135]_R[0-9]{2}$",
      "type": "string"
    },
    "history_length": {
      "enum": [
        1,
        3,
        5
      ]
    },
    "history_mode": {
      "enum": [
        "canonical",
        "endogenous"
      ]
    },
    "messages": {
      "items": {
        "properties": {
          "content": {
            "type": "string"
          },
          "role": {
            "enum": [
              "user",
              "assistant"
            ]
          }
        },
        "required": [
          "role",
          "content"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "revision": {
      "minimum": 1,
      "type": "integer"
    }
  },
  "required": [
    "history_id",
    "frame_id",
    "history_length",
    "history_mode",
    "messages",
    "revision"
  ],
  "type": "object"
}
