{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "properties": {
    "original_response_options": {
      "minItems": 2,
      "type": "array"
    },
    "pole_a": {
      "type": "string"
    },
    "pole_b": {
      "type": "string"
    },
    "question_text": {
      "minLength": 1,
      "type": "string"
    },
    "revision": {
      "minimum": 1,
      "type": "integer"
    },
    "suitable_for_value_elicitation": {
      "type": "boolean"
    },
    "value_domain": {
      "type": "string"
    },
    "wvs_item_id": {
      "pattern": "^Q[0-9]+$",
      "type": "string"
    }
  },
  "required": [
    "wvs_item_id",
    "question_text",
    "original_response_options",
    "item_type",
    "suitable_for_value_elicitation",
    "value_domain",
    "pole_a",
    "pole_b",
    "revision"
  ],
  "type": "object"
}
