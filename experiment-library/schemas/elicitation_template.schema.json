{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "properties": {
    "allows_indifference": {
      "type": "boolean"
    },
    "elicitation_id": {
      "pattern": "^E[0-9]{2}$",
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "primary": {
      "type": "boolean"
    },
    "prompt_template": {
      "minLength": 1,
      "type": "string"
    },
    "revision": {
      "minimum": 1,
      "type": "integer"
    }
  },
  "required": [
    "elicitation_id",
    "name",
    "primary",
    "allows_indifference",
    "prompt_template",
    "revision"
  ],
  "type": "object"
}
