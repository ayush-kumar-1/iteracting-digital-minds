{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["elicitation_id", "name", "primary", "allows_indifference", "prompt_template", "revision"],
  "properties": {
    "elicitation_id": {"type": "string", "pattern": "^E[0-9]{2}$"},
    "name": {"type": "string"},
    "primary": {"type": "boolean"},
    "allows_indifference": {"type": "boolean"},
    "prompt_template": {"type": "string", "minLength": 1},
    "revision": {"type": "integer", "minimum": 1}
  },
  "additionalProperties": true
}
